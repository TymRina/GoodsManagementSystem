/* 顶部通用样式 */
#top_widget>* {
    font-family: '微软雅黑';
    color: white;
}

/* 输入框基础样式 */
QLineEdit {
    border: 1px solid #139667;
    height: 30px;
    line-height: 30px;
    font-size: 12px;
    vertical-align: middle;
    color: #333;
    padding: 0 8px;
    border-radius: 4px;
}

/* 下拉框样式 */
QComboBox {
    border: 1px solid #139667;
    background-color: #efefef;
    height: 30px;
    min-width: 100px;
    line-height: 30px;
    font-size: 12px;
    vertical-align: middle;
    color: #333;
    padding: 0 8px;
    border-radius: 4px;
}

/* 数字输入框样式 */
QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit {
    border: 1px solid #139667;
    height: 30px;
    line-height: 30px;
    font-size: 12px;
    vertical-align: middle;
    color: #333;
    padding: 0 8px;
    border-radius: 4px;
}

/* 文本编辑框样式 */
QPlainTextEdit {
    border: 1px solid #139667;
    font-size: 12px;
    color: #333;
    padding: 5px;
    border-radius: 4px;
}

/* 滚动区域样式 */
QScrollArea#home_widget_scrollArea {
    background-color: #ffffff;
    border: none;
}

QScrollArea#home_widget_scrollArea > QWidget {
    background-color: #ffffff;
}

/* 统计概览卡片样式 */
QWidget#home_wg2_gl_1_1_ct {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 rgba(252, 172, 82, 255),
        stop:0.55 rgba(255, 160, 66, 255),
        stop:1 rgba(235, 129, 8, 255)
    );
    border-radius: 8px;
    padding: 15px;
}

QWidget#home_wg2_gl_1_2_ct {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #61a6fe,
        stop:0.55 #529bf5,
        stop:1 #4691ef
    );
    border-radius: 8px;
    padding: 15px;
}

QWidget#home_wg2_gl_1_3_ct {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #3ac9c5,
        stop:0.55 #22b9b5,
        stop:1 #15b0ac
    );
    border-radius: 8px;
    padding: 15px;
}

QWidget#home_wg2_gl_2_1_ct {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #f96e6e,
        stop:0.55 #ed5959,
        stop:1 #e44949
    );
    border-radius: 8px;
    padding: 15px;
}

QWidget#home_wg2_gl_2_2_ct {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #d970f2,
        stop:0.55 #db52d4,
        stop:1 #dc3cbc
    );
    border-radius: 8px;
    padding: 15px;
}

QWidget#home_wg2_gl_2_3_ct {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 rgba(252, 172, 82, 255),
        stop:0.55 rgba(255, 160, 66, 255),
        stop:1 rgba(235, 129, 8, 255)
    );
    border-radius: 8px;
    padding: 15px;
}

/* 统计卡片文字样式 */
.home_wg2_item_label_value {
    color: #ffffff;
    font-weight: 600;
    font-size: 24px;
    margin-bottom: 5px;
    text-align: left;
    padding-left: 10px;
}

.home_wg2_item_label_name {
    color: #ffffff;
    font-size: 16px;
    margin-bottom: 3px;
    text-align: left;
    padding-left: 10px;
}

.home_wg2_item_label_remark {
    color: #ffffff;
    font-size: 12px;
    opacity: 0.8;
    text-align: left;
    padding-left: 10px;
}

/* 标题样式 */
.home_item_label_title {
    color: #333;
    line-height: 40px;
    border-left: 6px solid #67c1a5;
    padding-left: 10px;
    font-weight: 600;
}

/* 表格样式 - 改进 */
QTableWidget {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    gridline-color: #e0e0e0;
    font-size: 12px;
}

QHeaderView::section {
    background-color: #139667;
    color: white;
    font-weight: bold;
    padding: 6px;
    border: none;
    font-size: 12px;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:selected {
    background-color: #67c1a5;
    color: #FFFFFF;
}

/* 隔行变色 */
QTableWidget::item:alternate {
    background-color: #f9f9f9;
}

/* 确认按钮样式 */
.QPushButton_Primary {
    border: 1px #139667 solid;
    background: #19a97b;
    color: white;
    padding: 8px 20px;
    height: 35px;
    cursor: pointer;
    border-radius: 4px;
    min-width: 80px;
}

.QPushButton_Primary:hover {
    background: #139667;
}

.QPushButton_Primary:pressed {
    font-weight: 600;
    background: #0d7a52;
}

/* 取消按钮样式 */
.QPushButton_Cancel {
    border: 1px #767777 solid;
    background: rgb(212, 212, 212);
    color: white;
    padding: 8px 20px;
    height: 35px;
    cursor: pointer;
    border-radius: 4px;
    min-width: 80px;
}

.QPushButton_Cancel:hover {
    background: #8e8f8f;
}

.QPushButton_Cancel:pressed {
    font-weight: 600;
    background: #4e4e4e;
}

/* 登录窗口样式 */
QWidget#login_box {
    background-color: rgba(220, 220, 220, 0.5);
    border-radius: 20px;
    padding: 30px;
}

QLineEdit#user_line, QLineEdit#pwd_line {
    background-color: rgba(255, 172, 194, 0.7);
    border: none;
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 15px;
    font-size: 14px;
}

QLineEdit#user_line:focus, QLineEdit#pwd_line:focus {
    border: 1px solid #4d90fe;
    background-color: white;
}

QPushButton#login_btn {
    background-color: rgb(85, 170, 127);
    border: none;
    border-radius: 10px;
    color: white;
    font-size: 16px;
    font-weight: bold;
    padding: 15px;
    min-width: 200px;
}

QPushButton#login_btn:hover {
    background-color: #45a049;
}

QPushButton#login_btn:pressed {
    background-color: #3e8e41;
}

/* 工具按钮样式 */
QToolButton {
    padding: 8px 12px;
    margin: 0 4px;
    border-radius: 6px;
    min-height: 80px;  /* 增加高度避免文字遮挡 */
}

QToolButton::icon {
    width: 55px;
    height: 55px;
    margin-bottom: 6px;
}

QToolButton::text {
    font-size: 12px;
    line-height: 1.2;
}

/* 统计概览文本颜色修复 */
QWidget[objectName^="home_wg2_gl_"] QLabel {
    color: #ffffff;
    text-align: left;
    padding-left: 10px;
}

QWidget[objectName^="home_wg2_gl_"] QLabel:first-child {
    font-size: 24px;
    font-weight: 600;
}

QWidget[objectName^="home_wg2_gl_"] QLabel:nth-child(2) {
    font-size: 16px;
    margin: 5px 0;
}

QWidget[objectName^="home_wg2_gl_"] QLabel:last-child {
    font-size: 12px;
    opacity: 0.8;
}